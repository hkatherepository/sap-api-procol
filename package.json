{
  "name": "sap-procol-integration",
  "version": "1.0.0",
  "private": true,
  "description": "Backend sinkronisasi SAP ke database Si Procol",
  "type": "module",
  "bin": {
    "sap-sync": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "sap-sync": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "decimal.js": "^10.6.0",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}

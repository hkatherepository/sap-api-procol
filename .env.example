NODE_ENV=production

# PostgreSQL through the db-tunnel Compose service.
# Password must be URL-encoded if it contains special URL characters.
# tunnel = pakai SSH tunnel (dev lokal). Kosongkan kalau DB satu server dengan app.
COMPOSE_PROFILES=tunnel
DATABASE_URL=postgresql://fariz_db:replace-with-url-encoded-password@db-tunnel:15432/procol_fariz

# SSH tunnel configuration. Do not add an SSH password.
SSH_HOST=38.47.88.75
SSH_PORT=22
SSH_USER=fariz
SSH_REMOTE_DB_HOST=127.0.0.1
SSH_REMOTE_DB_PORT=5432
SSH_TUNNEL_PORT=15432

SAP_VENDOR_API_URL=https://10.30.68.21:9935/zapi_hka/zhka_int0003?sap-client=310
SAP_PR_API_URL=https://10.30.68.21:9935/zapi_hka/zhka_int0002?sap-client=310
SAP_PO_API_URL=https://10.30.68.21:9935/zapi_hka/zhka_int0001?sap-client=310
SAP_API_USERNAME=
SAP_API_PASSWORD=
SAP_HTTP_METHOD=POST
SAP_FILTER_TRANSPORT=json_body
SAP_FILTER_LOW_PARAM=low
SAP_FILTER_HIGH_PARAM=high
SAP_CA_CERT_PATH=/run/secrets/sap-ca.crt
# Temporary compatibility mode for the current SAP certificate/IP mismatch.
# Set to true after the official hostname or certificate pinning is implemented.
SAP_TLS_REJECT_UNAUTHORIZED=false
SAP_API_TIMEOUT_MS=30000
SAP_MAX_RESPONSE_MB=50
SAP_NUMBER_FORMAT=id-ID

SYNC_SCHEDULES=0 7 * * *,0 12 * * *,0 19 * * *
SYNC_TIMEZONE=Asia/Jakarta
SYNC_BATCH_SIZE=200
DRY_RUN_ONLY=true
# Keep false during controlled manual apply. Enable only after backfill approval.
SYNC_SCHEDULER_ENABLED=false
AUDIT_RETENTION_DAYS=90
HOUSEKEEPING_SCHEDULE=30 2 * * *

SERVICE_HOST=0.0.0.0
SERVICE_PORT=3000
LOG_LEVEL=info
